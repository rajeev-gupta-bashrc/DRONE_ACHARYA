<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Define parameters -->
  <xacro:property name="size" value="0.1"/>
  <xacro:property name="mass" value="0.001"/>
  <xacro:property name="inertia" value="${(1/6) * mass * size * size}"/>

  <model name="cube">
    <link name="base_link">
      <inertial>
        <pose>0 0 ${-size/2} 0 0 0</pose>
        <mass>${mass}</mass>
        <inertia>
          <ixx>${inertia}</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>${inertia}</iyy>
          <iyz>0</iyz>
          <izz>${inertia}</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <pose>0 0 -${size/2} 0 0 0</pose>
        <geometry>
          <box>
            <size>${size} ${size} ${size}</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="base_visual">
        <pose>0 0 -${size/2} 0 0 0</pose>
        <geometry>
          <box>
            <size>${size} ${size} ${size}</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05</ambient>
          <diffuse>0.05 0.05 0.05</diffuse>
          <specular>1 1 1 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</robot>
