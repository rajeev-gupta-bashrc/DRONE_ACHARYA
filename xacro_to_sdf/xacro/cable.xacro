<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cable">

  <!-- Define common variables -->
  <xacro:property name="num_links" value="15" />
  <xacro:property name="radius" value="0.005" />
  <xacro:property name="length" value="0.1" />
  <xacro:property name="mass" value="0.00001" />
  <xacro:property name="gap" value="0.005" />

  <!-- Inertia calculation variables -->
  <xacro:property name="ixx_iyy" value="${(1.0/12.0) * mass * (3 * radius * radius + length * length)}" />
  <xacro:property name="izz" value="${(1.0/2.0) * mass * radius * radius}" />

  <!-- Define link and joint macro -->
  <xacro:macro name="create_link_and_joint" params="index x_axis">
    <link name="link${index}">
      <pose>0 0 ${-gap - (index) * length} 0 0 0</pose>
      <inertial>
        <pose>0 0 -${length/2} 0 0 0</pose>
        <mass>${mass}</mass>
        <inertia>
          <ixx>${ixx_iyy}</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>${ixx_iyy}</iyy>
          <iyz>0</iyz>
          <izz>${izz}</izz>
        </inertia>
      </inertial>
      <visual name="visual${index}">
        <pose>0 0 -${length/2} 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>${radius}</radius>
            <length>${length}</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.8 1</ambient>
          <diffuse>0.1 0.1 0.8 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <joint name="joint${index-1}" type="revolute">
      <child>link${index}</child>
      <parent>link${index-1}</parent>
      <axis>
        <xyz>${x_axis} ${1-x_axis} 0</xyz>
        <limit>
          <lower>-3.14/3</lower>
          <upper>3.14/3</upper>
        </limit>
        <dynamics>
          <damping>0.4</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
    </joint>
  </xacro:macro>

<model name="cable">

  <!-- Base link -->
  <link name="link0">
    <inertial>
      <pose>0 0 -0.055 0 0 0</pose>
      <mass>0.00001</mass>
      <inertia>
        <ixx>0.0000016833</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.0000016833</iyy>
        <iyz>0</iyz>
        <izz>0.00000005</izz>
      </inertia>
    </inertial>
    <visual name="link0_visual">
      <pose>0 0 -0.055 0 0 0</pose>
      <geometry>
        <cylinder>
          <radius>0.005</radius>
          <length>0.1</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>0.1 0.1 0.8 1</ambient>
        <diffuse>0.1 0.1 0.8 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </link>

  <!-- Manually create links and joints -->
  <xacro:create_link_and_joint index="1"  x_axis="1" />
  <xacro:create_link_and_joint index="2"  x_axis="0" />
  <xacro:create_link_and_joint index="3"  x_axis="1" />
  <xacro:create_link_and_joint index="4"  x_axis="0" />
  <xacro:create_link_and_joint index="5"  x_axis="1" />
  <xacro:create_link_and_joint index="6"  x_axis="0" />
  <xacro:create_link_and_joint index="7"  x_axis="1" />
  <xacro:create_link_and_joint index="8"  x_axis="0" />
  <xacro:create_link_and_joint index="9"  x_axis="1" />
  <xacro:create_link_and_joint index="10" x_axis="0" />
  <xacro:create_link_and_joint index="11" x_axis="1" />
  <xacro:create_link_and_joint index="12" x_axis="0" />
  <xacro:create_link_and_joint index="13" x_axis="1" />
  <xacro:create_link_and_joint index="14" x_axis="0" />
  <xacro:create_link_and_joint index="15" x_axis="1" />

</model>
</robot>
